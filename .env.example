# Copy to .env and fill in what you need. Everything is optional for local runs.

# --- Vector store ---------------------------------------------------------
# Unset -> embedded Qdrant on disk at QDRANT_PATH (no server needed).
# Set   -> Qdrant server: local Docker (http://localhost:6333) or Qdrant Cloud.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=data/qdrant
COLLECTION=rfp_chunks

# --- Models (run locally via fastembed / ONNX, no API key needed) ---------
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# --- Parsing fallback -------------------------------------------------------
# Pages with (almost) no text layer are sent to the Unstructured Transform API
# when a key is set, otherwise OCR'd locally with RapidOCR if installed.
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://transform.unstructured.io/api/v2
ENABLE_LOCAL_OCR=true

# --- LLM (any OpenAI-compatible endpoint) ---------------------------------
# Groq by default. For OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b

# Silences a harmless HuggingFace cache warning on Windows.
HF_HUB_DISABLE_SYMLINKS_WARNING=1
